---
import { Image } from 'astro:assets';
import { homepageThemeAssets } from '../../config/homepage-content';
---

<section class="home-cont-ban py-5" aria-labelledby="home-contact-ban-title">
  <Image
    src={homepageThemeAssets.contactBanner}
    alt=""
    class="home-cont-ban__bg"
    widths={[768, 1200, 1600]}
    sizes="100vw"
    loading="lazy"
    decoding="async"
  />
  <div class="container">
    <div class="ban-content">
      <h2 id="home-contact-ban-title" class="text-unq">اتصل بنا</h2>
      <p class="text-main">نحن دائما على استعداد لتقديم العرض الذي يلبي تطلعاتك</p>
      <button type="button" class="pw-btn btn-main" data-open-dialog="pw-book-modal">
        تواصل معنا
      </button>
    </div>
  </div>
</section>
