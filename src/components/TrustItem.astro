---
interface Props {
  title: string;
  text: string;
}

const { title, text } = Astro.props;
---

<article class="trust-item">
  <h3 class="trust-item__title">{title}</h3>
  <p class="trust-item__text">{text}</p>
</article>

<style>
  .trust-item {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1rem 1.125rem;
    height: 100%;
  }
  .trust-item__title {
    margin: 0 0 0.35rem;
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-primary);
  }
  .trust-item__text {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }
</style>
