---
import { site } from '../config/site';
---

<div class="mobile-bar" role="navigation" aria-label="تواصل سريع">
  <a
    href={site.whatsapp.href()}
    class="mobile-bar__btn mobile-bar__btn--wa"
    data-conversion="whatsapp"
    rel="noopener noreferrer"
    target="_blank"
  >
    واتساب
  </a>
  <a
    href={site.phone.telHref}
    class="mobile-bar__btn mobile-bar__btn--tel"
    data-conversion="phone"
  >
    اتصال
  </a>
</div>

<style>
  .mobile-bar {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 60;
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: var(--mobile-bar-height);
    padding-bottom: env(safe-area-inset-bottom, 0px);
    background: var(--color-primary);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 -4px 24px rgba(0, 0, 0, 0.12);
  }
  @media (min-width: 768px) {
    .mobile-bar {
      display: none;
    }
  }
  .mobile-bar__btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.15rem;
    font-family: inherit;
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
    color: #fff;
    padding: 0.5rem;
  }
  .mobile-bar__btn--wa {
    background: var(--color-whatsapp);
  }
  .mobile-bar__btn--tel {
    background: #0f2740;
  }
</style>
