---
import { Image } from 'astro:assets';
import { assetSources } from '../../config/project-images';
import { site } from '../../config/site';
import { homepageContent } from '../../config/homepage-content';
import { homePaths, menuItemHref } from '../../config/home-routes';

const mainItems = homepageContent.navMenus['main-nav'];
const topLevel = mainItems.filter((i) => i.parentId === 0);
const childrenOf = (parentId: number) =>
  mainItems.filter((i) => i.parentId === parentId);
const sideItems = homepageContent.navMenus['side-menu'];
---

<div class="home-header-top" id="pw-header-top">
  <div class="container home-header-top__inner">
    <p class="promo-text">{site.serviceArea.homepagePromo}</p>
    <div class="home-header-top__contact contact-info">
      <a href={site.phone.telHref} data-conversion="phone">{site.phone.display}</a>
      <a href={site.email.href}>{site.email.address}</a>
    </div>
  </div>
</div>

<header id="pw-header">
  <div class="container home-header__inner">
    <a href={homePaths.home} class="home-header__brand pw-logo">
      <Image
        src={assetSources.logo.file}
        alt=""
        width={100}
        height={100}
        densities={[1, 2]}
        loading="eager"
        decoding="async"
        class="nav-logo"
      />
      <span class="home-header__najlaa najlaa">{site.nameEn}</span>
    </a>

    <nav id="pw-main-nav" aria-label="التنقل الرئيسي">
      <ul>
        {
          topLevel.map((item) => {
            const href = menuItemHref(item);
            const kids = childrenOf(item.id);
            const isCurrent = href === homePaths.home;
            return (
              <li class:list={[{ 'menu-item-has-children': kids.length > 0 }, { 'is-current': isCurrent }]}>
                <a href={href}>{item.title}</a>
                {kids.length > 0 && (
                  <ul class="sub-menu">
                    {kids.map((child) => (
                      <li>
                        <a href={menuItemHref(child)}>{child.title}</a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="home-header__actions">
      <button
        type="button"
        class="pw-head-btn1 pw-btn-search header-icon"
        aria-label="بحث الموقع"
        data-open-dialog="pw-search-modal"
      >
        🔍
      </button>
      <button type="button" class="pw-head-btn2" data-open-dialog="pw-book-modal">
        اتصل بنا
      </button>
    </div>

    <button type="button" class="home-header__menu-toggle" aria-expanded="false" aria-controls="pw-side-menu" data-open-nav>
      ☰
    </button>
  </div>
</header>

<div id="pw-side-menu" aria-hidden="true">
  <div class="pw-side-backdrop" data-close-nav />
  <div class="pw-side-panel" role="dialog" aria-label="القائمة">
    <ul class="pw-side-menu">
      {
        sideItems.map((item) => (
          <li>
            <a href={menuItemHref(item)} data-close-nav-link>
              {item.title}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<script>
  const menu = document.getElementById('pw-side-menu');
  const openBtns = document.querySelectorAll('[data-open-nav]');

  function setOpen(open: boolean) {
    menu?.classList.toggle('is-open', open);
    menu?.setAttribute('aria-hidden', open ? 'false' : 'true');
    openBtns.forEach((btn) => btn.setAttribute('aria-expanded', open ? 'true' : 'false'));
    document.body.style.overflow = open ? 'hidden' : '';
  }

  openBtns.forEach((btn) => btn.addEventListener('click', () => setOpen(true)));
  document.querySelectorAll('[data-close-nav], [data-close-nav-link]').forEach((el) => {
    el.addEventListener('click', () => setOpen(false));
  });
</script>
