{
  "name": "najlaashutter-web",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:staging": "PUBLIC_STAGING=true astro build",
    "build:staging:no-gtm": "PUBLIC_STAGING=true PUBLIC_DISABLE_GTM=true astro build",
    "preview": "astro preview",
    "deploy": "wrangler deploy",
    "review:overflow": "node scripts/verify-mobile-overflow.mjs",
    "astro": "astro",
    "build:replica": "python3 scripts/mirror-wordpress.py build",
    "verify:replica": "python3 scripts/verify-replica.py",
    "build:replica:fixed": "python3 scripts/mirror-wordpress.py build && python3 scripts/verify-replica.py && python3 scripts/improve-replica.py && python3 scripts/verify-fixes.py && node scripts/test-contact-fixes.mjs"
  },
  "devDependencies": {
    "playwright": "^1.55.0",
    "wrangler": "^4.149.0"
  },
  "dependencies": {
    "astro": "^7.3.8",
    "sharp": "^0.35.5"
  }
}
