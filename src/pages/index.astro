---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeSiteHeader from '../components/home/HomeSiteHeader.astro';
import HomeSiteFooter from '../components/home/HomeSiteFooter.astro';
import HomeFixedFooter from '../components/home/HomeFixedFooter.astro';
import HomeHero from '../components/home/HomeHero.astro';
import HomeContactDialog from '../components/home/HomeContactDialog.astro';
import GoogleReviewsSlot from '../components/home/GoogleReviewsSlot.astro';
import HomeFloatingControls from '../components/home/HomeFloatingControls.astro';
import HomeSwiperNav from '../components/home/HomeSwiperNav.astro';
import AtiraIcon from '../components/home/AtiraIcon.astro';
import {
  blogFeaturedByPostId,
  homepageContent,
  homepageThemeAssets,
  serviceCoverByFile,
} from '../config/homepage-content';
import { homePaths } from '../config/home-routes';
import { projectGalleryImages } from '../config/project-images';
import { site } from '../config/site';
import '../styles/home-atira.css';

const title = `${site.name} | تركيب شتر نوافذ في جدة ومكة`;
const description = site.description;

const formatBlogDate = (sqlDate: string) => {
  const d = new Date(sqlDate.replace(' ', 'T'));
  const pad = (n: number) => String(n).padStart(2, '0');
  return `${pad(d.getDate())}/${pad(d.getMonth() + 1)}/${d.getFullYear()}`;
};

const gallerySlides = await Promise.all(
  projectGalleryImages.map(async (item) => {
    const optimized = await getImage({ src: item.file, width: 1200, format: 'webp' });
    return { ...item, fullSrc: optimized.src };
  }),
);

const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  name: site.legalName,
  url: site.url,
  telephone: site.phone.e164,
  email: site.email.address,
  areaServed: [{ '@type': 'City', name: 'Jeddah' }, { '@type': 'City', name: 'Makkah' }],
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.location.city,
    addressRegion: site.location.region,
    addressCountry: 'SA',
  },
};
---

<BaseLayout
  {title}
  {description}
  canonicalPath="/"
  bodyClass="home-atira has-fixed-footer"
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(localBusiness)}
    slot="head"
  />

  <HomeSiteHeader slot="header" />

  <div>
    <h1 class="visually-hidden">{site.name} — تركيب شتر نوافذ في جدة</h1>

    <HomeHero />

    <!-- Services -->
    <section class="py-5 services section-bg" id="main-srv" aria-labelledby="services-heading">
      <div class="container">
        <div class="section-title">
          <h2 id="services-heading" class="fs-1 fw-bold text-unq">خدماتنا</h2>
          <p class="fs-5 text-main fw-bold">نقدّم خدمات عالية الجودة</p>
        </div>
        <div class="swiper pw-hom-swp1">
          <div class="swiper-wrapper">
            {
              homepageContent.services.map((srv) => {
                const img = serviceCoverByFile[srv.featuredImageFile] ?? homepageThemeAssets.defaultCard;
                const href = homePaths.service(srv.slug);
                return (
                  <div class="swiper-slide">
                    <div class="box-srv">
                      <article class="card h-100 shadow border-0 srv-card bg-main">
                        <div class="p-0 pw-clip-btm rounded-top overflow-hidden">
                          <a href={href} title={srv.title}>
                            <Image
                              src={img}
                              alt=""
                              widths={[360, 720, 1024]}
                              sizes="(max-width:768px) 88vw, 360px"
                              width={360}
                              height={156}
                              loading="lazy"
                              decoding="async"
                              class="w-100"
                            />
                          </a>
                        </div>
                        <div class="card-body bg-main srv-card__body">
                          <a href={href} class="text-white text-center">
                            <h3 class="card-title fs-5 pb-2 fw-bold text-unq pw-2lin">{srv.title}</h3>
                          </a>
                          <p class="pw-cex card-text d-none d-lg-block pw-3lin mb-2 text-white fs-6">{srv.excerpt}</p>
                        </div>
                        <div class="card-footer bg-main rounded-bottom srv-card__footer">
                          <div class="text-center">
                            <a href={href} class="text-white">مشاهدة التفاصيل</a>
                          </div>
                        </div>
                      </article>
                    </div>
                  </div>
                );
              })
            }
          </div>
        </div>
        <HomeSwiperNav
          prevClass="pw-hom1-prev"
          nextClass="pw-hom1-next"
          centerHref={homePaths.services}
          centerLabel="عرض المزيد"
        />
      </div>
    </section>

    <!-- About -->
    <section class="py-5 section-bg bg-new" aria-labelledby="about-heading">
      <div class="container">
        <div class="row align-items-center">
          <div class="col-12 col-lg-5 text-center">
            <div class="pw-home-img position-relative rounded-4 overflow-hidden" data-home-animate data-animate="fade-down" style="--home-anim-dur: 1000ms">
              <div class="pw-home-img-bg" />
              <Image
                src={homepageThemeAssets.aboutExperts}
                alt="تركيب شتر النوافذ — نجلاء شتر"
                widths={[480, 640, 800]}
                sizes="(max-width:992px) 100vw, 480px"
                loading="lazy"
                decoding="async"
                class="img-fluid shadow-sm position-relative"
              />
            </div>
          </div>
          <div class="col-12 col-lg-7 text-start">
            <div class="ps-0 ps-lg-5">
              <h2 id="about-heading" class="text-main mt-3 fs-2 fw-bold">
                <span class="text-unq">تركيب شتر النوافذ</span> باحترافية تضمن لكم الراحة والحماية
              </h2>
              <p class="fs-5 text-justify">
                في نجلاء شتر، نقدم حلول شتر متكاملة تجمع بين الجودة والمتانة والأناقة. نحرص على
                استخدام أفضل المواد وأحدث التقنيات لضمان حصولك على منتجات عملية وجميلة تلبي جميع
                احتياجات منزلك أو منشأتك.
              </p>
              <ul class="list-unstyled fs-5">
                <li class="list-group-item mb-3">
                  <AtiraIcon name="check-circle" class="text-unq-inline" />
                  <strong class="text-unq">جودة منتجاتنا:</strong> منتجاتنا مصممة بعناية فائقة
                  لتدوم طويلاً وتوفّر الحماية والعزل المثالي.
                </li>
                <li class="list-group-item">
                  <AtiraIcon name="check-circle" class="text-unq-inline" />
                  <strong class="text-unq">خبرتنا:</strong> فريقنا من المتخصصين يقدم تركيبًا
                  احترافيًا لكل أنواع الشتر، مع التركيز على التفاصيل لضمان رضا العملاء.
                </li>
              </ul>
              <a class="pw-btn btn-main d-inline-block" href={homePaths.about}>
                <AtiraIcon name="arrow-left-circle" /> اقرأ المزيد
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Projects -->
    <section class="py-5 pw-clip-box" aria-labelledby="projects-heading">
      <div class="container">
        <div class="section-title">
          <h2 id="projects-heading">استكشف أعمالنا</h2>
          <p class="text-main">تصفح معرض الصور واكتشف جودة وإبداع أعمالنا</p>
        </div>
        <div class="swiper pw-hom-swp3-projects">
          <div class="swiper-wrapper">
            {
              gallerySlides.map((item) => (
                <div class="swiper-slide">
                  <button
                    type="button"
                    class="pw-hgal-btn"
                    data-lightbox-open={item.fullSrc}
                    aria-label={`عرض صورة: ${item.alt}`}
                  >
                    <Image
                      src={item.file}
                      alt={item.alt}
                      widths={[400, 600, 830]}
                      sizes="(max-width:768px) 88vw, 380px"
                      loading="lazy"
                      decoding="async"
                      class="pw-hgal-img w-100 rounded shadow-sm"
                    />
                  </button>
                </div>
              ))
            }
          </div>
        </div>
        <HomeSwiperNav
          prevClass="pw-hom3-prev"
          nextClass="pw-hom3-next"
          centerHref={homePaths.projects}
          centerLabel="عرض المزيد"
        />
      </div>
    </section>

    <GoogleReviewsSlot />

    <!-- Why us -->
    <section class="section-why-us" aria-labelledby="why-heading">
      <div class="container why-grid">
        <div class="text-center">
          <div class="image-container" data-home-animate data-animate="zoom-in-left" style="--home-anim-dur: 1500ms">
            <div class="corner-decoration corner-top-left" />
            <div class="corner-decoration corner-bottom-right" />
            <div class="pw-home-img rounded-4 shadow">
              <Image
                src={homepageThemeAssets.whyChooseUs}
                alt="لماذا تختار نجلاء شتر"
                widths={[480, 640]}
                sizes="(max-width:768px) 100vw, 480px"
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>
        </div>
        <div>
          <h2 id="why-heading" class="text-main fs-1 mb-4">لماذا تختارنا؟</h2>
          <div class="feature-box" data-home-animate data-animate="fade-up" style="--home-anim-dur: 1000ms">
            <div class="feature-box__row">
              <div class="feature-icon"><AtiraIcon name="star" /></div>
              <div>
                <h3 class="fs-5 mb-2 text-main">جودة عالية وأسعار مناسبة</h3>
                <p class="fs-6 text-sub m-0">
                  نقدم حلول شتر عالية الجودة تجمع بين المتانة والأناقة، مع أسعار تلائم جميع
                  الميزانيات
                </p>
              </div>
            </div>
          </div>
          <div class="feature-box" data-home-animate data-animate="fade-up" style="--home-anim-dur: 2000ms">
            <div class="feature-box__row">
              <div class="feature-icon"><AtiraIcon name="people" /></div>
              <div>
                <h3 class="fs-5 mb-2 text-main">فريق محترف وخبرة طويلة</h3>
                <p class="fs-6 text-sub m-0">
                  فريقنا يلتزم بتقديم خدمة احترافية منذ البداية وحتى ما بعد التركيب
                </p>
              </div>
            </div>
          </div>
          <div class="feature-box" data-home-animate data-animate="fade-up" style="--home-anim-dur: 3000ms">
            <div class="feature-box__row">
              <div class="feature-icon"><AtiraIcon name="check-circle" /></div>
              <div>
                <h3 class="fs-5 mb-2 text-main">رضا العملاء أولويتنا</h3>
                <p class="fs-6 text-sub m-0">
                  نركز على التفاصيل لضمان رضا العملاء التام وتقديم تجربة سلسة وموثوقة
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-3 py-lg-5 bg-new" aria-labelledby="faq-heading">
      <div class="container">
        <div class="row align-items-center justify-content-center">
          <div class="col-12 col-md-6 col-lg-7">
            <div class="text-center mb-2 section-title">
              <h2 id="faq-heading" class="fs-1 fw-bold text-unq">الأسئلة الشائعة</h2>
              <p class="fs-5 text-main fw-bold">يسعدنا الإجابة على استفساراتكم.</p>
            </div>
            <div class="home-accordion" id="accordionExample">
              {
                homepageContent.faqs.map((faq, i) => (
                  <div
                    class="accordion-item my-2 rounded-2 border-0 shadow-sm overflow-hidden"
                    data-faq-item
                    data-home-animate
                    data-animate="fade-in"
                    style={`--home-anim-dur: ${(i + 1) * 1000}ms`}
                  >
                    <h3 class="accordion-header">
                      <button
                        type="button"
                        class="accordion-button collapsed"
                        data-faq-trigger
                        aria-expanded="false"
                      >
                        <AtiraIcon name="plus-circle" /> {faq.question}
                      </button>
                    </h3>
                    <div class="accordion-collapse" data-faq-panel hidden>
                      <div class="accordion-body">
                        <p>{faq.answer}</p>
                      </div>
                    </div>
                  </div>
                ))
              }
            </div>
            <div class="text-center my-4 mx-3">
              <a class="pw-btn btn-main d-inline-block" href={homePaths.faq}>مزيد من الأسئلة الشائعة</a>
            </div>
          </div>
          <div class="col-12 col-md-6 col-lg-5 text-center mb-2">
            <Image
              src={homepageThemeAssets.faqSide}
              alt=""
              widths={[480, 640]}
              sizes="(max-width:992px) 100vw, 480px"
              loading="lazy"
              decoding="async"
              class="img-fluid rounded-4 shadow-md"
              data-home-animate
              data-animate="fade-down"
              style="--home-anim-dur: 1000ms"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Blog -->
    <section class="py-5" aria-labelledby="blog-heading">
      <div class="container">
        <div class="section-title">
          <h2 id="blog-heading">المدونة</h2>
          <p class="text-main">احدث المقالات والاخبار</p>
        </div>
        <div class="swiper pw-hom-swp3-blog">
          <div class="swiper-wrapper">
            {
              homepageContent.blogRecent.map((post) => {
                const featured = blogFeaturedByPostId[post.id] ?? homepageThemeAssets.defaultCard;
                return (
                  <div class="swiper-slide">
                    <article class="card h-100 shadow-sm blog-card bg-main">
                      <div class="pw-clip-btm rounded-top-2">
                        <a href={homePaths.blogPost(post.slug)} title={post.title}>
                          <Image
                            src={featured}
                            alt=""
                            widths={[400, 600, 800]}
                            sizes="(max-width:768px) 88vw, 380px"
                            loading="lazy"
                            decoding="async"
                            class="w-100"
                          />
                        </a>
                      </div>
                      <div class="card-body bg-main srv-card__body">
                        <a href={homePaths.blogPost(post.slug)} class="text-unq">
                          <h3 class="card-title fs-5 pb-1 fw-bold pw-2lin">{post.title}</h3>
                        </a>
                        <p class="card-text d-none d-lg-block pw-3lin mb-2 text-white fs-6">{post.excerpt}</p>
                      </div>
                      <div class="card-footer bg-main blog-card__meta">
                        <div class="row">
                          <div class="col">
                            <p class="card-text m-0">
                              <small class="text-light">
                                <AtiraIcon name="calendar" /> {formatBlogDate(post.date)}
                              </small>
                            </p>
                          </div>
                          <div class="col text-end">
                            <a href={homePaths.blogPost(post.slug)} class="text-white">اقرأ المزيد</a>
                          </div>
                        </div>
                      </div>
                    </article>
                  </div>
                );
              })
            }
          </div>
        </div>
        <HomeSwiperNav
          prevClass="pw-hom4-prev"
          nextClass="pw-hom4-next"
          centerHref={homePaths.blog}
          centerLabel="عرض المزيد"
        />
      </div>
    </section>
  </div>

  <HomeContactDialog />
  <HomeFloatingControls />

  <dialog id="pw-project-lightbox" class="home-lightbox">
    <button type="button" class="home-lightbox__close" data-lightbox-close aria-label="إغلاق">×</button>
    <img id="pw-project-lightbox-img" alt="" />
  </dialog>

  <HomeSiteFooter slot="footer" />
  <HomeFixedFooter slot="mobile" />
</BaseLayout>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script>
  import '../scripts/home-init.ts';

  function initFadeCarousels(root: ParentNode = document) {
    root.querySelectorAll('[data-fade-carousel]').forEach((rootEl) => {
      const slides = [...rootEl.querySelectorAll<HTMLElement>('.hero-carousel__slide')];
      if (!slides.length) return;
      let idx = slides.findIndex((s) => s.classList.contains('is-active'));
      if (idx < 0) idx = 0;

      const show = (i: number) => {
        slides.forEach((s, j) => {
          s.classList.toggle('is-active', j === i);
          const img = s.querySelector('img');
          if (img && j === i && !img.getAttribute('src')) {
            const dataSrc = img.getAttribute('data-src');
            if (dataSrc) img.setAttribute('src', dataSrc);
          }
        });
        idx = i;
      };

      rootEl.querySelector('[data-fade-prev]')?.addEventListener('click', () => {
        show((idx - 1 + slides.length) % slides.length);
      });
      rootEl.querySelector('[data-fade-next]')?.addEventListener('click', () => {
        show((idx + 1) % slides.length);
      });

      const delay = Number(rootEl.getAttribute('data-autoplay-delay') || 7000);
      if (delay > 0 && slides.length > 1) {
        window.addEventListener(
          'load',
          () => {
            setTimeout(() => {
              setInterval(() => show((idx + 1) % slides.length), delay);
            }, 3500);
          },
          { once: true },
        );
      }
    });
  }

  initFadeCarousels();
  document.addEventListener('home:carousels-init', () => initFadeCarousels());

  const lightbox = document.getElementById('pw-project-lightbox') as HTMLDialogElement | null;
  const lightboxImg = document.getElementById('pw-project-lightbox-img') as HTMLImageElement | null;
  document.querySelectorAll('[data-lightbox-open]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const src = btn.getAttribute('data-lightbox-open');
      if (!src || !lightbox || !lightboxImg) return;
      lightboxImg.src = src;
      lightbox.showModal();
    });
  });
  document.querySelectorAll('[data-lightbox-close]').forEach((btn) => {
    btn.addEventListener('click', () => lightbox?.close());
  });
  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) lightbox.close();
  });
</script>
