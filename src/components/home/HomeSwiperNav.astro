---
import AtiraIcon from './AtiraIcon.astro';

interface Props {
  prevClass: string;
  nextClass: string;
  centerHref: string;
  centerLabel: string;
  centerExternal?: boolean;
}

const { prevClass, nextClass, centerHref, centerLabel, centerExternal = false } = Astro.props;
---

<div class="row mb-5 mt-2 pw-swp-tol-row">
  <div class="col-12 col-md-3 col-lg-4 d-none d-md-block" aria-hidden="true"></div>
  <div class="col-12 col-md-6 col-lg-4">
    <div class="pw-swp-tol my-2 p-2">
      <div class="row align-items-center">
        <div class={`col-2 text-start ${prevClass}`} role="button" tabindex="0" aria-label="السابق">
          <AtiraIcon name="arrow-right-circle" class="swiper-nav-icon" />
        </div>
        <div class="col-8 text-center">
          <a
            class="pw-btn btn-main d-inline-block"
            href={centerHref}
            target={centerExternal ? '_blank' : undefined}
            rel={centerExternal ? 'noopener noreferrer' : undefined}
          >
            {centerLabel}
          </a>
        </div>
        <div class={`col-2 text-end ${nextClass}`} role="button" tabindex="0" aria-label="التالي">
          <AtiraIcon name="arrow-left-circle" class="swiper-nav-icon" />
        </div>
      </div>
    </div>
  </div>
  <div class="col-12 col-md-3 col-lg-4 d-none d-md-block" aria-hidden="true"></div>
</div>
