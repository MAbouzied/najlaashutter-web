---
import { site } from '../../config/site';
import HomeSwiperNav from './HomeSwiperNav.astro';
import AtiraIcon from './AtiraIcon.astro';

export interface GoogleReview {
  authorName: string;
  text: string;
  rating: number;
  publishedAt: string;
}

/** Static verified reviews only — no fabrication. API sync is a separate task. */
export const googleReviewsData: GoogleReview[] = [];
---

<section class="py-lg-5 pw-clip-box reviews-section" aria-labelledby="reviews-heading">
  <div class="container">
    <div class="my-3 text-center section-title">
      <h2 id="reviews-heading" class="fs-1 fw-bold text-unq">آراء عملائنا</h2>
    </div>

    <div class="swiper pw-hom-swp2">
      <div class="swiper-wrapper">
        {
          googleReviewsData.length > 0 ? (
            googleReviewsData.map((rev) => (
              <div class="swiper-slide">
                <article class="p-3 my-4 mx-auto pw-rev rounded-4 shadow-sm">
                  <img class="pw-rev-img" src="/favicon.png" alt="" width="40" height="40" loading="lazy" />
                  <h3 class="fs-4 text-main text-center pt-3">{rev.authorName}</h3>
                  <div class="text-warning text-center" aria-label={`${rev.rating} stars`}>
                    {[1, 2, 3, 4, 5].map(() => (
                      <AtiraIcon name="star" />
                    ))}
                  </div>
                  <p class="fst-italic text-muted">
                    <AtiraIcon name="quote" />
                    {rev.text}
                    <AtiraIcon name="quote" />
                  </p>
                </article>
              </div>
            ))
          ) : (
            <div class="swiper-slide">
              <article class="p-3 my-4 mx-auto pw-rev rounded-4 shadow-sm pw-rev--shell">
                <img class="pw-rev-img" src="/favicon.png" alt="" width="40" height="40" loading="lazy" />
                <h3 class="fs-4 text-main text-center pt-3">—</h3>
                <div class="text-warning text-center" aria-hidden="true">
                  {[1, 2, 3, 4, 5].map(() => (
                    <AtiraIcon name="star" />
                  ))}
                </div>
                <p class="fst-italic text-muted text-center">
                  <span class="visually-hidden">التقييمات:</span>
                  سيتم عرض آراء عملاء Google الموثّقة هنا. لا تُعرض مراجعات WordPress المكررة.
                </p>
              </article>
            </div>
          )
        }
      </div>
    </div>

    <HomeSwiperNav
      prevClass="pw-hom2-prev"
      nextClass="pw-hom2-next"
      centerHref={site.googleBusinessProfileUrl}
      centerLabel="مزيد من التعليقات"
      centerExternal
    />
  </div>
</section>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
