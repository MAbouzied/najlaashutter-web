---
import { Image } from 'astro:assets';
import { assetSources } from '../../config/project-images';
import { site } from '../../config/site';
import { homepageContent } from '../../config/homepage-content';
import { homePaths, menuItemHref } from '../../config/home-routes';
import AtiraIcon from './AtiraIcon.astro';

const mainItems = homepageContent.navMenus['main-nav'];
const topLevel = mainItems.filter((i) => i.parentId === 0);
const childrenOf = (parentId: number) => mainItems.filter((i) => i.parentId === parentId);
const sideItems = homepageContent.navMenus['side-menu'];
const serviceChildren = sideItems.filter((i) =>
  ['شتر النوافذ بالتحكم عن بعد', 'شتر النوافذ الذكي', 'شتر النوافذ الداخلي', 'شتر النوافذ الخارجي', 'شتر النوافذ اليدوي'].includes(
    i.title,
  ),
);
const sideTop = sideItems.filter((i) => !serviceChildren.includes(i));
---

<section id="pw-header-top" class="bg-fff home-header-top">
  <div class="container-lg">
    <div class="row align-items-center d-none d-lg-flex">
      <div class="col-4" aria-hidden="true"></div>
      <div class="col-12 col-lg-4 text-center text-lg-start">
        <span class="promo-text text-main">{site.serviceArea.homepagePromo}</span>
      </div>
      <div class="col-4 text-end">
        <div class="contact-info">
          <a class="text-main" href={site.phone.telHref} data-conversion="phone">
            {site.phone.display}
            <AtiraIcon name="headset" />
          </a>
          <a
            class="text-main"
            href={site.whatsapp.href('')}
            target="_blank"
            rel="noopener noreferrer"
            data-conversion="whatsapp"
          >
            تواصل الان
            <AtiraIcon name="whatsapp" />
          </a>
        </div>
      </div>
    </div>
    <div class="row align-items-center bg-main d-flex d-lg-none home-header-top__mobile">
      <div class="col-6">
        <div class="pw-logo py-1 d-flex align-items-center">
          <div class="d-inline-block me-2 fw-bold text-end text-unq home-header-top__wordmark">
            <span class="najlaa lh-1">NAJLAA</span><br />SHUTTER
          </div>
          <a href={homePaths.home} title={site.name}>
            <Image
              src={assetSources.logo.file}
              alt={site.name}
              width={70}
              height={70}
              densities={[1, 2]}
              loading="eager"
              class="img-fluid nav-logo"
            />
          </a>
        </div>
      </div>
      <div class="col-6 text-end">
        <button
          type="button"
          class="pw-btn-search btn-unq"
          aria-label="بحث الموقع"
          data-open-dialog="pw-search-modal"
        >
          <AtiraIcon name="search" />
        </button>
      </div>
    </div>
  </div>
</section>

<header id="pw-header" class="home-header-sticky">
  <div class="container home-header__inner d-none d-lg-flex">
    <a href={homePaths.home} class="home-header__brand pw-logo">
      <Image
        src={assetSources.logo.file}
        alt=""
        width={100}
        height={100}
        densities={[1, 2]}
        loading="eager"
        decoding="async"
        class="nav-logo"
      />
      <span class="home-header__najlaa najlaa">{site.nameEn}</span>
    </a>

    <nav id="pw-main-nav" aria-label="التنقل الرئيسي">
      <ul>
        {
          topLevel.map((item) => {
            const href = menuItemHref(item);
            const kids = childrenOf(item.id);
            const isCurrent = href === homePaths.home;
            return (
              <li class:list={[{ 'menu-item-has-children': kids.length > 0 }, { 'is-current': isCurrent }]}>
                <a href={href}>{item.title}</a>
                {kids.length > 0 && (
                  <ul class="sub-menu">
                    {kids.map((child) => (
                      <li>
                        <a href={menuItemHref(child)}>{child.title}</a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="home-header__actions">
      <button
        type="button"
        class="pw-head-btn1 pw-btn-search header-icon"
        aria-label="بحث الموقع"
        data-open-dialog="pw-search-modal"
      >
        <AtiraIcon name="search" />
      </button>
      <button type="button" class="pw-head-btn2" data-open-dialog="pw-book-modal">اتصل بنا</button>
    </div>
  </div>
</header>

<div id="pw-bottom-menu" class="pw-bottom-menu" aria-hidden="true">
  <div class="pw-bottom-menu__backdrop" data-close-nav></div>
  <div class="pw-bottom-menu__sheet" role="dialog" aria-label="القائمة">
    <button type="button" class="pw-bottom-menu__close" data-close-nav aria-label="إغلاق">×</button>
    <ul class="pw-side-menu">
      {
        sideTop.map((item) => (
          <li>
            {item.title === 'الخدمات' ? (
              <>
                <button type="button" class="pw-side-menu__toggle" data-services-toggle aria-expanded="false">
                  {item.title}
                </button>
                <ul class="pw-side-menu__sub" data-services-sub>
                  {serviceChildren.map((child) => (
                    <li>
                      <a href={menuItemHref(child)} data-close-nav-link>
                        {child.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </>
            ) : (
              <a href={menuItemHref(item)} data-close-nav-link>
                {item.title}
              </a>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</div>
