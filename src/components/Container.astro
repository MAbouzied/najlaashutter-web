---
interface Props {
  class?: string;
  narrow?: boolean;
}

const { class: className = '', narrow = false } = Astro.props;
---

<div class:list={['container', narrow && 'container--narrow', className]}>
  <slot />
</div>

<style>
  .container {
    width: var(--container);
    margin-inline: auto;
  }
  .container--narrow {
    width: min(720px, 100% - 2rem);
  }
</style>
