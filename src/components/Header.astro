---
import { Image } from 'astro:assets';
import { assetSources } from '../config/project-images';
import { site } from '../config/site';
import Button from './Button.astro';

interface Props {
  minimal?: boolean;
  language?: 'ar' | 'en';
}

const { minimal = true, language = 'ar' } = Astro.props;
const english = language === 'en';
const whatsappMessage = english ? 'Hello, I would like a quote for window roller shutters in Jeddah.' : undefined;
---

<header class="site-header">
  <div class="site-header__inner">
    <a href={english ? '/en/' : site.paths.landingJeddah} class="site-header__brand" aria-label={site.name}>
      <Image
        src={assetSources.logo.file}
        alt=""
        width={96}
        height={96}
        densities={[1, 2]}
        loading="eager"
        decoding="async"
        class="site-header__logo"
      />
      <span class="site-header__wordmark">
        <span class="site-header__en">NAJLAA</span>
        <span class="site-header__sub">SHUTTER</span>
      </span>
    </a>
    {
      !minimal && (
        <nav class="site-header__nav" aria-label="التنقل الرئيسي">
          <slot name="nav" />
        </nav>
      )
    }
    <a class="site-header__language" href={english ? '/' : '/en/'} lang={english ? 'ar' : 'en'} dir={english ? 'rtl' : 'ltr'}>{english ? 'العربية' : 'English'}</a>
    <div class="site-header__actions">
      <Button href={site.phone.telHref} variant="ghost" conversion="phone" ariaLabel={english ? 'Call Najlaa Shutter' : 'اتصل بنجلاء شتر'}>{english ? 'Call now' : 'اتصل الآن'}</Button>
      <Button href={site.whatsapp.href(whatsappMessage)} variant="whatsapp" external conversion="whatsapp" ariaLabel={english ? 'Contact Najlaa Shutter on WhatsApp' : 'تواصل مع نجلاء شتر عبر واتساب'}>{english ? 'WhatsApp' : 'واتساب'}</Button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-primary);
    color: #fff;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.12);
    border-bottom: 3px solid var(--color-secondary);
  }
  .site-header__inner {
    width: var(--container);
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 0;
  }
  .site-header__brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: inherit;
  }
  .site-header__logo {
    width: 48px;
    height: 48px;
    object-fit: contain;
  }
  .site-header__wordmark {
    display: flex;
    flex-direction: column;
    line-height: 1.05;
    font-weight: 700;
    color: #fff;
  }
  .site-header__en {
    font-size: 0.9rem;
    letter-spacing: 0.06em;
    color: var(--color-secondary);
  }
  .site-header__sub {
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.92);
  }
  .site-header__language { color: #fff; font-size: 0.9rem; text-underline-offset: 0.25em; margin-inline-start: auto; }
  .site-header__actions {
    display: none;
    align-items: center;
    gap: 0.5rem;
  }
  @media (min-width: 768px) {
    .site-header__actions {
      display: flex;
    }
  }
  .site-header__actions :global(.btn--ghost) {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.45);
  }
  .site-header__actions :global(.btn--ghost:hover) {
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
  }
  @media (max-width: 767px) {
    .site-header__brand {
      min-width: 0;
    }
    .site-header__wordmark {
      min-width: 0;
    }
  }
</style>
