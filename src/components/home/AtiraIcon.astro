---
/** Local inline SVG — Bootstrap Icons–equivalent shapes, no CDN. */
interface Props {
  name:
    | 'search'
    | 'whatsapp'
    | 'telephone'
    | 'menu'
    | 'envelope'
    | 'share'
    | 'star'
    | 'people'
    | 'check-circle';
  class?: string;
}

const { name, class: className = '' } = Astro.props;
const cls = `atira-icon ${className}`.trim();
---

