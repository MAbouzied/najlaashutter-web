---
import { site } from '../../config/site';
import AtiraIcon from './AtiraIcon.astro';
---

<a
  class="pw-wts heart-beat"
  href={site.whatsapp.href()}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="واتساب"
  data-conversion="whatsapp"
>
  <AtiraIcon name="whatsapp" />
</a>

<button type="button" class="progress" id="pw-to-top" aria-label="العودة للأعلى">
  <svg width="40" height="40" viewBox="0 0 40 40" aria-hidden="true">
    <circle cx="20" cy="20" r="18" fill="none" stroke="rgba(255,255,255,0.25)" stroke-width="3"></circle>
    <circle
      data-progress-ring
      cx="20"
      cy="20"
      r="18"
      fill="none"
      stroke="#8e9dad"
      stroke-width="3"
      stroke-linecap="round"
      transform="rotate(-90 20 20)"
      style="stroke-dasharray: 113; stroke-dashoffset: 113"
    ></circle>
  </svg>
  <span class="progress__arrow">↑</span>
</button>
