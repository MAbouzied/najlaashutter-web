---
import { Image } from 'astro:assets';
import { assetSources } from '../config/project-images';
import { site } from '../config/site';
import PhoneCTA from './PhoneCTA.astro';
import WhatsAppCTA from './WhatsAppCTA.astro';

interface Props {
  minimal?: boolean;
}

const { minimal = true } = Astro.props;
---

<header class="site-header">
  <div class="site-header__inner">
    <a href={site.paths.landingJeddah} class="site-header__brand" aria-label={site.name}>
      <Image
        src={assetSources.logo.file}
        alt=""
        width={96}
        height={96}
        densities={[1, 2]}
        loading="eager"
        decoding="async"
        class="site-header__logo"
      />
      <span class="site-header__wordmark">
        <span class="site-header__en">NAJLAA</span>
        <span class="site-header__sub">SHUTTER</span>
      </span>
    </a>
    {
      !minimal && (
        <nav class="site-header__nav" aria-label="التنقل الرئيسي">
          <slot name="nav" />
        </nav>
      )
    }
    <a class="site-header__language" href="/en/" lang="en" dir="ltr">English</a>
    <div class="site-header__actions">
      <PhoneCTA class="site-header__phone" variant="ghost" />
      <WhatsAppCTA label="واتساب" />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-primary);
    color: #fff;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.12);
    border-bottom: 3px solid var(--color-secondary);
  }
  .site-header__inner {
    width: var(--container);
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 0;
  }
  .site-header__brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: inherit;
  }
  .site-header__logo {
    width: 48px;
    height: 48px;
    object-fit: contain;
  }
  .site-header__wordmark {
    display: flex;
    flex-direction: column;
    line-height: 1.05;
    font-weight: 700;
    color: #fff;
  }
  .site-header__en {
    font-size: 0.9rem;
    letter-spacing: 0.06em;
    color: var(--color-secondary);
  }
  .site-header__sub {
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.92);
  }
  .site-header__language { color: #fff; font-size: 0.9rem; text-underline-offset: 0.25em; margin-inline-start: auto; }
  .site-header__actions {
    display: none;
    align-items: center;
    gap: 0.5rem;
  }
  @media (min-width: 768px) {
    .site-header__language { color: #fff; font-size: 0.9rem; text-underline-offset: 0.25em; margin-inline-start: auto; }
  .site-header__actions {
      display: flex;
    }
  }
  .site-header__actions :global(.btn--ghost) {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.45);
  }
  .site-header__actions :global(.btn--ghost:hover) {
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
  }
  @media (max-width: 767px) {
    .site-header__brand {
      min-width: 0;
    }
    .site-header__wordmark {
      min-width: 0;
    }
  }
</style>
