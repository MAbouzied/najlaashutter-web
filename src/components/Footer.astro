---
import { Image } from 'astro:assets';
import { assetSources } from '../config/project-images';
import { isAdsSite } from '../config/env';
import { site } from '../config/site';

interface Props {
  minimal?: boolean;
  /** LP-only override; defaults to global serviceAreaNote. */
  serviceAreaNote?: string;
}

const { minimal = true, serviceAreaNote = site.serviceAreaNote } = Astro.props;
const brandHref = isAdsSite ? '/' : site.paths.landingJeddah;
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <a href={brandHref} class="site-footer__brand-link" aria-label={site.name}>
        <Image
          src={assetSources.logo.file}
          alt=""
          width={104}
          height={104}
          densities={[1, 2]}
          loading="lazy"
          decoding="async"
          class="site-footer__logo"
        />
        <span class="site-footer__wordmark">
          <span class="site-footer__en">NAJLAA</span>
          <span class="site-footer__sub">SHUTTER</span>
        </span>
      </a>
      <p class="site-footer__tagline">{serviceAreaNote}</p>
    </div>
    <div class="site-footer__contact">
      <a href={site.phone.telHref} data-conversion="phone" class="site-footer__link">
        {site.phone.display}
      </a>
      <a
        href={site.whatsapp.href()}
        data-conversion="whatsapp"
        class="site-footer__link"
        rel="noopener noreferrer"
        target="_blank"
      >
        واتساب
      </a>
      {
        minimal && (
          <a href={site.paths.privacyPolicy} class="site-footer__link site-footer__muted">
            سياسة الخصوصية
          </a>
        )
      }
    </div>
  </div>
  <p class="site-footer__copy">© {new Date().getFullYear()} {site.name}</p>
</footer>

<style>
  .site-footer {
    background: var(--color-primary);
    color: rgba(255, 255, 255, 0.92);
    padding: 2rem 1rem 1.25rem;
    margin-top: auto;
    border-top: 3px solid var(--color-secondary);
  }
  .site-footer__inner {
    width: var(--container);
    margin-inline: auto;
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    align-items: flex-start;
    justify-content: space-between;
  }
  .site-footer__brand-link {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: inherit;
  }
  .site-footer__logo {
    width: 48px;
    height: 48px;
    object-fit: contain;
    flex-shrink: 0;
  }
  .site-footer__wordmark {
    display: flex;
    flex-direction: column;
    line-height: 1.05;
    font-weight: 700;
    color: var(--color-secondary);
  }
  .site-footer__en {
    font-size: 0.85rem;
    letter-spacing: 0.04em;
  }
  .site-footer__sub {
    font-size: 0.7rem;
    letter-spacing: 0.06em;
  }
  .site-footer__tagline {
    margin: 0.75rem 0 0;
    font-size: 0.9rem;
    max-width: 22rem;
    color: rgba(255, 255, 255, 0.82);
  }
  .site-footer__contact {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .site-footer__link {
    color: #fff;
    text-decoration: none;
    font-weight: 600;
  }
  .site-footer__link:hover {
    text-decoration: underline;
  }
  .site-footer__muted {
    font-weight: 400;
    font-size: 0.875rem;
    opacity: 0.85;
  }
  .site-footer__copy {
    width: var(--container);
    margin: 1.25rem auto 0;
    font-size: 0.8rem;
    opacity: 0.7;
    text-align: center;
  }
</style>
