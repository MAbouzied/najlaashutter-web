---
import { Image } from 'astro:assets';
import { assetSources } from '../../config/project-images';
import { site } from '../../config/site';
import { homepageContent } from '../../config/homepage-content';
import { menuItemHref } from '../../config/home-routes';
import footerBg from '../../assets/theme/footer-bg.jpg';

const foot1 = homepageContent.navMenus['foot-1'];
const foot2 = homepageContent.navMenus['foot-2'];
const footMenu = homepageContent.navMenus['foot-menu'];
---

<footer id="footer" class="home-footer">
  <Image
    src={footerBg}
    alt=""
    class="home-footer__bg"
    widths={[768, 1400]}
    sizes="100vw"
    loading="lazy"
    decoding="async"
  />
  <div class="container home-footer__grid">
    <div class="home-footer__brand-col">
      <a href="/" class="home-header__brand pw-logo-footer">
        <Image
          src={assetSources.logo.file}
          alt=""
          width={104}
          height={104}
          densities={[1, 2]}
          loading="lazy"
          decoding="async"
          class="nav-logo"
        />
        <span class="visually-hidden">{site.name}</span>
      </a>
      <p class="home-footer__desc">{site.description}</p>
      <div class="contact-list">
        <a href={site.phone.telHref} data-conversion="phone">{site.phone.display}</a>
        <a href={site.email.href}>{site.email.address}</a>
        <span>{site.location.shortLabel}</span>
      </div>
      <div class="socials" aria-label="وسائل التواصل (قيد التحقق)">
        <span class="social-icon social-icon--disabled" title="حسابات التواصل قيد التحقق">f</span>
        <span class="social-icon social-icon--disabled" title="حسابات التواصل قيد التحقق">in</span>
      </div>
    </div>
    <div>
      <h3>روابط سريعة</h3>
      <ul class="pw-fot-lst">
        {
          foot1.map((item) => (
            <li>
              <a href={menuItemHref(item)}>{item.title}</a>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <h3>خدماتنا</h3>
      <ul class="pw-fot-lst">
        {
          foot2.map((item) => (
            <li>
              <a href={menuItemHref(item)}>{item.title}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <ul class="pw-fot-mnu container">
    {
      footMenu.map((item) => (
        <li>
          <a href={menuItemHref(item)}>{item.title}</a>
        </li>
      ))
    }
  </ul>
  <p class="home-footer__copy container">
    © {new Date().getFullYear()} {site.name} — {site.serviceArea.footerNote}
  </p>
</footer>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
