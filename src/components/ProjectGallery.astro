---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Item {
  file: ImageMetadata;
  alt: string;
}

interface Props {
  items: readonly Item[];
  title?: string;
}

const { items, title = 'مشاريع منفذة' } = Astro.props;
---

<div class="gallery">
  <h2 class="gallery__title" id="projects-heading">{title}</h2>
  <ul class="gallery__grid">
    {
      items.map((item, i) => (
        <li class="gallery__item">
          <Image
            src={item.file}
            alt={item.alt}
            widths={[400, 600, 800]}
            sizes="(max-width: 640px) 50vw, (max-width: 960px) 33vw, 25vw"
            loading={i < 2 ? 'eager' : 'lazy'}
            decoding="async"
            class="gallery__img"
          />
        </li>
      ))
    }
  </ul>
</div>

<style>
  .gallery__title {
    margin: 0 0 1.25rem;
    font-size: clamp(1.35rem, 3vw, 1.75rem);
    font-weight: 700;
    color: var(--color-primary);
    text-align: center;
  }
  .gallery__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }
  @media (min-width: 640px) {
    .gallery__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
    }
  }
  @media (min-width: 960px) {
    .gallery__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .gallery__item {
    margin: 0;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-surface);
    box-shadow: var(--shadow-soft);
  }
  .gallery__img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
</style>
